<sdf version="1.5">
     <model name="sorghum_variant_2">
          <static>true</static>
          <link name="link">
               <inertial>
                    <pose>0 0 0 0 0 0</pose>
                    <mass>4</mass>
                    <inertia>
                         <ixx>0.01</ixx>
                         <ixy>0</ixy>
                         <ixz>0</ixz>
                         <iyy>0.01</iyy>
                         <iyz>0</iyz>
                         <izz>0.01</izz>
                    </inertia>
               </inertial>

               <collision name='collision'>
                    <pose>0 0 0.625 0 0 0</pose>
                    <geometry>
                         <cylinder>
                              <radius>0.0075</radius>
                              <length>1.25</length>
                         </cylinder>
                    </geometry>
                    <max_contacts>10</max_contacts>
               </collision>

               <visual name="stem">
                    <geometry>
                         <mesh>
                              <uri>model://sorghum_variant_2/meshes/sorghum_variant_2.dae</uri>
                              <submesh>
                                   <name>Stem</name>
                              </submesh>
                         </mesh>
                    </geometry>
                    <material>
                         <script>
                              <uri>model://sorghum_variant_2/materials/scripts/</uri>
                              <uri>model://sorghum_variant_2/materials/textures/</uri>
                              <name>Sorghum/Stem</name>
                         </script>
                    </material>
               </visual>

               <visual name="leaves">
                    <geometry>
                         <mesh>
                              <uri>model://sorghum_variant_2/meshes/sorghum_variant_2.dae</uri>
                              <submesh>
                                   <name>Leaves</name>
                              </submesh>
                         </mesh>
                    </geometry>
                    <material>
                         <script>
                              <uri>model://sorghum_variant_2/materials/scripts/</uri>
                              <uri>model://sorghum_variant_2/materials/textures/</uri>
                              <name>Sorghum/Leaves</name>
                         </script>
                    </material>
               </visual>

               <visual name="tip">
                    <geometry>
                         <mesh>
                              <uri>model://sorghum_variant_2/meshes/sorghum_variant_2.dae</uri>
                              <submesh>
                                   <name>Tip</name>
                              </submesh>
                         </mesh>
                    </geometry>
                    <material>
                         <script>
                              <uri>model://sorghum_variant_2/materials/scripts/</uri>
                              <uri>model://sorghum_variant_2/materials/textures/</uri>
                              <name>Sorghum/Tip</name>
                         </script>
                    </material>
               </visual>

          </link>
     </model>
</sdf>
